<?xml version="1.0" encoding="utf-8"?>
<!-- Encrypted connections only, and only to a server whose certificate was issued by
     the Jarvis certificate authority on your own computer (bundled at build time as
     res/raw/jarvis_ca.pem). Public websites are not trusted inside the app; links open
     in your normal browser instead. -->
<network-security-config>
    <!-- Jarvis running on this phone itself (inside Termux) is reached at localhost; that
         traffic never leaves the phone. Everything else stays HTTPS-only. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="@raw/jarvis_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
